{
    "name": "spacework/tutor-learning-paths",
    "description": "Learning Paths & Course Prerequisites for Tutor LMS.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.19",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SpaceWork\\TutorLearningPaths\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpaceWork\\TutorLearningPaths\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find src templates tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:integration": "phpunit --configuration phpunit-integration.xml.dist",
        "test:contract": "phpunit --configuration phpunit-integration.xml.dist --group contract",
        "test": [
            "@lint",
            "@test:unit"
        ],
        "install:wp": "bin/install-wp-tests.sh wordpress_test root '' 127.0.0.1 latest",
        "install:tutor": "bin/install-tutor.sh"
    },
    "scripts-descriptions": {
        "test:unit": "Domain logic only. Fast, no WordPress, no database.",
        "test:integration": "Real WordPress and real Tutor LMS. Needs install:wp and install:tutor first.",
        "test:contract": "Just the tests that check our fixtures still agree with Tutor. Run this first when the integration suite goes red."
    }
}
