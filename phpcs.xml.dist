<?xml version="1.0"?>
<ruleset name="Tutor Learning Paths">
	<description>WordPress coding standards for the plugin.</description>

	<file>src</file>
	<file>templates</file>
	<file>tests</file>
	<file>tutor-learning-paths.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- The plugin targets PHP 8.1 and uses short closures and enums. -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="tutor-learning-paths"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="tlp,TLP,SpaceWork\TutorLearningPaths"/>
		</properties>
	</rule>

	<!-- Tests are not shipped and do not need the full production ruleset. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>
</ruleset>
